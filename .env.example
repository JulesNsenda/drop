# DROP configuration (copy to .env or export in your shell/service unit).
# All values are optional; sensible defaults apply.

# ── Paths ────────────────────────────────────────────────────────────────
# Root directory for all DROP data (Windows default: C:\drop, else /var/drop)
# DROP_ROOT=/var/drop
# Override just the watched webapps directory
# DROP_APPS_DIR=/var/drop/data/webapps

# ── API & auth ───────────────────────────────────────────────────────────
# API server port (default 3000)
# DROP_API_PORT=3000
# Auth is ON by default. Set to true ONLY for trusted local development.
# DROP_DISABLE_AUTH=false
# Comma-separated allowlist of browser origins for the API. Default: same-origin
# only. Set this if a separate front-end / third-party client calls the API.
# DROP_CORS_ORIGINS=https://dashboard.example.com

# ── Secrets encryption ───────────────────────────────────────────────────
# Master key for app-secret encryption. If unset, DROP uses the auto-generated
# data/drop-svc/encryption.key file. Set this to manage the key externally
# (e.g. from a secrets manager). Changing it re-encrypts existing secrets.
# DROP_MASTER_KEY=

# ── GitHub auto-redeploy webhooks ────────────────────────────────────────
# Shared secret used to verify GitHub webhook signatures (HMAC-SHA256).
# STRONGLY RECOMMENDED whenever auto-redeploy is enabled — without it,
# webhook redeploys are unauthenticated (this becomes mandatory in a future
# release). Use the same value in the GitHub webhook config.
# DROP_GITHUB_WEBHOOK_SECRET=

# ── Per-user limits ──────────────────────────────────────────────────────
# Default max apps per user (0 = unlimited). Per-user overrides via admin UI.
# DROP_MAX_APPS_PER_USER=5

# ── HTTPS / Caddy (optional) ─────────────────────────────────────────────
# DROP_ENABLE_HTTPS=false
# DROP_DOMAIN_SUFFIX=example.com
# DROP_ACME_EMAIL=you@example.com
# DROP_DNS_CF_API_TOKEN=
