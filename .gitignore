# ─── Reference repositories (external) ───────────────────────────────────────
# Third-party / client source trees. NEVER publish. Both the directory form and
# the glob are kept deliberately: this is the highest-consequence rule in this
# file, and a single-pattern typo would expose proprietary code into a public
# repo irreversibly.
docs/.reference/
docs/.reference/**

# ─── docs/ is INTERNAL BY DEFAULT ────────────────────────────────────────────
# Fail-closed. Everything under docs/ is ignored unless explicitly re-included
# in the allowlist below, so a new internal note dropped into docs/ can never
# become publishable by accident.
#
# To publish a doc: add an explicit `!docs/<name>` line — and read the file for
# host specifics (IPs, the live box's topology, credentials) BEFORE you do.
docs/*

# Internal implementation plans — never published. Both spellings are listed:
# `docs/plan/` (singular) exists on disk and is NOT matched by `docs/plans/**`.
docs/plan/
docs/plan/**
docs/plans/
docs/plans/**

# Public docs — explicit allowlist.
!docs/AGENT-DEPLOY.md
!docs/CLEAN-CODE-GUIDELINES.md
!docs/GIT-BRANCHING-MODEL.md
!docs/GIT-REDEPLOY-AND-CUSTOM-DOMAINS.md
!docs/HETZNER-DEPLOY.md
!docs/HTTPS-SETUP.md
!docs/LOCAL-TESTING.md
!docs/VERSION-ROADMAP.md
!docs/examples/
!docs/specs/

drop-test/**

