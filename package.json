{
  "name": "drop",
  "version": "1.6.0",
  "description": "DROP - Deploy, Run, Operate, Publish. A lightweight, self-hosted PaaS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "drop": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc && node scripts/copy-assets.js",
    "build:dashboard": "cd src/dashboard && npm run build",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "paas",
    "platform",
    "deployment",
    "nodejs",
    "self-hosted"
  ],
  "author": "Jules Nsenda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulesNsenda/drop.git"
  },
  "bugs": {
    "url": "https://github.com/JulesNsenda/drop/issues"
  },
  "homepage": "https://github.com/JulesNsenda/drop#readme",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "dockerode": "^5.0.0",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "jose": "^6.1.3",
    "nodemailer": "9.0.5",
    "pg": "^8.13.0",
    "pm2": "^7.0.3",
    "tar": "^7.5.21",
    "yaml": "^2.6.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/dockerode": "^4.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "protobufjs": "^7.6.6"
  }
}
